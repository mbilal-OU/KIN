# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Never commit a real key, paste one into a chat, or put
# one in a screenshot.

# ---------------------------------------------------------------- AI provider
# Recommended free-first mode: deterministic scheduling and local responses.
# No model calls, API keys or per-request AI costs are required.
KIN_AI_PROVIDER=off

# Optional Gemma 4 via the Gemini API. Free-tier access/quotas and data-use
# terms vary; use only fictional inputs until a privacy/security review.
# KIN_AI_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_own_key
KIN_GEMMA_MODEL=gemma-4-26b-a4b-it

# Alternative fully local inference (no data leaves the machine):
#   ollama pull gemma4:e2b
# KIN_AI_PROVIDER=ollama
# KIN_OLLAMA_MODEL=gemma4:e2b
# KIN_OLLAMA_URL=http://localhost:11434/api/chat

# --------------------------------------------------------------------- NWS
# The National Weather Service asks API users to identify their application.
# Put your own project contact here before deploying anywhere public.
KIN_NWS_USER_AGENT=KIN-Hackday-Demo (hackday-student-project)

# ---------------------------------------------------------------- storage
# Where the local SQLite database lives. Defaults to ./kin_local.db
# KIN_DB_PATH=kin_local.db
